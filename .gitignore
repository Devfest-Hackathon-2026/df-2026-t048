# ZIPs duplicate the design assets already stored next to them.
/output/**/*.zip
# Intermediate authoring output and Office lock files are local only.
/output/**/build/
~$*
/packages/**/.dart_tool/
/packages/**/pubspec.lock
*.local.json
*.local.env
*.local.yaml
*.local.yml
*.local.toml
# Only checked-in examples and the fictional localhost demo belong in these
# directories. Ignore real configuration even if it lacks a .local suffix.
/admin_web/config/*.json
!/admin_web/config/*.example.json
!/admin_web/config/demo.json
/postcheck/config/*.json
!/postcheck/config/*.example.json
.firebaserc
**/.firebase/
**/GoogleService-Info.plist
**/google-services.json
**/firebase_options.dart
/admin_web/firebase.postcheck.json
/admin_web/web/maps.local.js

# Upstream GoogleSignIn test fixture contains a Google API key; not used by app.
/postcheck/vendor/google_sign_in_ios/darwin/Tests/GoogleService-Info.plist

# Private local handoff files containing actual client configuration.
/.private/

# Generated build logs can contain environment values and local signing details.
*.log

# Local authoring dependencies and intermediate outputs.
**/node_modules/
/output/**/.build/

# Local-only notes and hand-off prompts (not shared via Git; 2026-11-10)
/docs/tasks/
/docs/object-detection-diagnosis.md
/docs/object-detection-runbook.md

# Work artifacts (design drafts, screenshots, verification records, pitch drafts).
# Kept locally, not shared via Git (2026-11-10 user instruction).
/output/

